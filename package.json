{
  "name": "fundamentals-project-ts-template",
  "version": "1.0.0",
  "description": "Capstone Project TS Template",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "echo \"Dummy build script required for Autocode Compile\"",
    "ts-compile": "npx tsc",
    "compile": "sass src/scss/main.scss dist/css/main.css",
    "watch": "sass --watch src/scss/main.scss:dist/css/main.css",
    "dev": "npm-run-all copy:img --parallel sass watch:img",
    "sass": "sass src/scss/main.scss dist/css/main.css --watch",
    "watch:img": "chokidar \"src/img/**/*\" -c \"npm run copy:img\"",
    "copy:img": "copyfiles -u 1 src/img/**/* dist/"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "chokidar-cli": "^3.0.0",
    "copyfiles": "^2.4.1",
    "npm-run-all": "^4.1.5",
    "sass": "^1.99.0",
    "typescript": "^6.0.2"
  }
}
